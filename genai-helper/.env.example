# Copie para .env e preencha. NUNCA commite o .env.
# Chave em https://openrouter.ai/keys
OPENROUTER_API_KEY=

# openrouter = chama a API real | mock = respostas fixas (sem chave, sem internet)
LLM_MODE=openrouter

# Confira os nomes atuais em https://openrouter.ai/models
LLM_MODEL=openai/gpt-4o-mini
# Lista separada por vírgula, usada em ordem quando o principal falha
LLM_FALLBACK_MODELS=meta-llama/llama-3.3-70b-instruct:free

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=700
LLM_TIMEOUT_S=30
# novas tentativas por modelo (além da primeira), com backoff exponencial
LLM_MAX_RETRIES=2
LLM_BACKOFF_BASE_S=1.0
# envia response_format={"type":"json_object"} (desligue se o modelo não suportar)
LLM_JSON_MODE=true

# Headers recomendados pelo OpenRouter
APP_URL=https://github.com/[PREENCHER]/GLOBAL-IA
APP_TITLE=genai-helper CitizenTech

# Se definido, /alertas/{id}/aprovar e /rejeitar exigem o header X-Operador-Token
OPERADOR_TOKEN=

LOG_LEVEL=INFO
